{
  "name": "avdeb/qr-php",
  "description": "Simple PHP library for generating QR codes.",
  "type": "library",
  "keywords": [
    "qr code",
    "php",
    "qr code generator",
    "open source",
    "php library",
    "qr code php",
    "qr code api"
  ],
  "homepage": "https://avdeb.com/qr-code-generator/",
  "license": "MIT",
  "authors": [
    {
      "name": "AVDEB",
      "homepage": "https://avdeb.com/developers/"
    }
  ],
  "support": {
    "issues": "https://github.com/avdeb/qr-php/issues",
    "source": "https://github.com/avdeb/qr-php"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Avdeb\\QrPhp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Avdeb\\QrPhp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
